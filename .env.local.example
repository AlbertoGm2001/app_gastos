# Copia este fichero a .env.local (gitignorado) y rellena los valores.
# Lo lee vite.config.ts y solo llega al proceso de Node: el navegador no ve nada de esto.

# --- Enable Banking (https://enablebanking.com → Control Panel → API applications) ---
# Id de la aplicación (UUID) que asigna el Control Panel al registrarla.
ENABLE_BANKING_APPLICATION_ID=
# Ruta a la clave privada .pem que se descarga al registrar la aplicación.
# Guárdala fuera del repo, por ejemplo: C:/Users/tu-usuario/.enablebanking/<app-id>.pem
ENABLE_BANKING_KEY_PATH=
# País de los bancos a listar (ISO-2).
ENABLE_BANKING_COUNTRY=ES
# Debe estar en la whitelist de redirect URLs de la aplicación en el Control Panel.
# Producción exige https:// (rechaza http con "unsupported scheme"); ver .certs/ y
# `npm run cert:trust`. En sandbox vale http.
ENABLE_BANKING_REDIRECT_URL=https://localhost:5173/api/bank/callback

# --- Postgres ---
# En local, el contenedor que levanta `npm run db:up`:
DATABASE_URL=postgres://gastos:gastos@localhost:5434/gastos
# En Neon, su connection string (lleva sslmode=require y se detecta solo). Usa el endpoint
# DIRECTO, no el que lleva "-pooler" en el host: por el pooler el search_path no es fiable
# y la app da errores intermitentes de 'relation "bank_transactions" does not exist'.
# Ver el comentario de createPool en server/db.mjs.

# --- Acceso a la app (server/auth.mjs) ---
# Usuario y contrasena unicos de la app. Sin los dos puestos, la API no sirve nada (503):
# es fail-closed a proposito, para que un despliegue sin entorno quede inservible y no
# publico. La contrasena se compara en tiempo constante y nunca sale al navegador.
AUTH_USERNAME=
AUTH_PASSWORD=
# Opcional: clave con la que se firma la cookie de sesion. Si se deja vacia se deriva de
# las credenciales, y entonces cambiar la contrasena invalida las sesiones abiertas.
AUTH_SECRET=
